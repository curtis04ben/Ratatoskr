<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon: the launcher masks this to its own shape (circle,
     squircle, ...). The foreground is the transparent logo from
     shared/assets/ratatoskr-mark.svg sized to the 66dp safe zone; the
     monochrome layer lets Android 13+ tint it for themed icons. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
